{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes:rerg:v1:capability-path-graph",
  "title": "RERG repository capability and inert path graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "can_execute", "mutation", "transport",
    "rollback_caveat", "catalog_id", "source_catalog_id",
    "source_catalog_path", "source_catalog_sha256", "source_primitive_map_id",
    "source_primitive_map_sha256", "nodes", "edges"
  ],
  "properties": {
    "schema_version": {"const": "rerg-capability-path-graph/v1"},
    "artifact_type": {"const": "capability-path-graph"},
    "can_execute": {"const": false},
    "mutation": {"$ref": "#/$defs/inertMutation"},
    "transport": {"$ref": "#/$defs/inertTransport"},
    "rollback_caveat": {
      "const": "rollback_does_not_cover_leaked_data_or_poisoned_memory"
    },
    "catalog_id": {"const": "hermes-capability-path-graph:session-kickoff/v1"},
    "source_catalog_id": {"const": "hermes-static-source:session-kickoff/v1"},
    "source_catalog_path": {"const": "catalogs/rerg/hermes-static-source.json"},
    "source_catalog_sha256": {
      "const": "sha256:04d766dd6ef4e2b15c918ca508d5a018ed7a019e07550d64a1d4629551e2c34d"
    },
    "source_primitive_map_id": {
      "const": "primitive-map:hermes-static-source:session-kickoff/v1"
    },
    "source_primitive_map_sha256": {
      "const": "sha256:833962de8915fe32ba1723963dbcee6459d0555c6e56954ac9735c58e581c28c"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "inertMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "inert"}}
    },
    "inertTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "inert"}}
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$)[A-Za-z0-9._/-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "input_fact_ids"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "input_fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "observedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "target", "capability", "value", "source", "observed_at"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "observed"},
        "target": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "value": {"type": "boolean"},
        "source": {"$ref": "#/$defs/source"},
        "observed_at": {"type": "string", "minLength": 1}
      }
    },
    "derivedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "target", "capability", "value", "derivation"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "derived"},
        "target": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "value": {"type": "boolean"},
        "derivation": {"$ref": "#/$defs/derivation"}
      }
    },
    "primitiveFact": {
      "oneOf": [
        {"$ref": "#/$defs/observedFact"},
        {"$ref": "#/$defs/derivedFact"}
      ]
    },
    "capabilityNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "capability", "primitive_fact"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "capability"},
        "capability": {"type": "string", "minLength": 1},
        "primitive_fact": {"$ref": "#/$defs/primitiveFact"}
      }
    },
    "pathNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "rank"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "repository_path"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "rank": {"type": "integer", "minimum": 1}
      }
    },
    "dependencyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "dependency"},
        "path": {"$ref": "#/$defs/repositoryPath"}
      }
    },
    "gateNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "gate", "blocking"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "gate"},
        "gate": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mutation", "transport"],
      "properties": {
        "kind": {"const": "read-only-fixture"},
        "mutation": {"const": "inert"},
        "transport": {"const": "inert"}
      }
    },
    "recipeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "recipe"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "inert_recipe"},
        "recipe": {"$ref": "#/$defs/recipe"}
      }
    },
    "node": {
      "oneOf": [
        {"$ref": "#/$defs/capabilityNode"},
        {"$ref": "#/$defs/pathNode"},
        {"$ref": "#/$defs/dependencyNode"},
        {"$ref": "#/$defs/gateNode"},
        {"$ref": "#/$defs/recipeNode"}
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["satisfied_by", "depends_on", "blocked_by", "uses_recipe"]
        },
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1}
      }
    }
  }
}
