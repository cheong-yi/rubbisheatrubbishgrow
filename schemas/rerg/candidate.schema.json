{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes:rerg:v1:candidate",
  "title": "RERG v1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "can_execute",
    "mutation",
    "transport",
    "rollback_caveat",
    "candidate_id",
    "candidate_type",
    "title",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "rerg/v1"},
    "artifact_type": {"const": "candidate"},
    "can_execute": {"type": "boolean", "const": false},
    "mutation": {"$ref": "#/$defs/inertMutation"},
    "transport": {"$ref": "#/$defs/inertTransport"},
    "rollback_caveat": {"const": "rollback_does_not_cover_leaked_data_or_poisoned_memory"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_type": {
      "enum": [
        "skill",
        "hook",
        "plugin",
        "prompt_workflow",
        "adapter",
        "eval_harness",
        "external_tool_service"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "inertMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "inert"}}
    },
    "inertTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "inert"}}
    }
  }
}
